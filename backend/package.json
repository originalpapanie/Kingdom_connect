{
  "name": "kingdom-connect-backend",
  "version": "0.1.0",
  "description": "KingdomConnect API - Church Management System",
  "main": "src/main.py",
  "scripts": {
    "start": "python -m uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "dev": "python -m uvicorn src.main:app --reload",
    "prod": "python -m uvicorn src.main:app --host 0.0.0.0 --port 8000",
    "migrate": "alembic upgrade head",
    "makemigrations": "alembic revision --autogenerate",
    "test": "pytest",
    "lint": "flake8 src/",
    "format": "black src/",
    "requirements": "pip freeze > requirements.txt"
  },
  "keywords": [
    "church",
    "management",
    "saas",
    "ministry"
  ],
  "author": "Kingdom Connect",
  "license": "MIT"
}
